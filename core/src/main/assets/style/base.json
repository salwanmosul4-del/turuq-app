{
  "version": 8,
  "name": "طرق عراقنا",
  "glyphs": "asset://glyphs/{fontstack}/{range}.pbf",
  "sources": {},
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#ECE6D6" } },
    { "id": "landuse-park", "type": "fill", "source": "omt", "source-layer": "landuse",
      "filter": ["in", "class", "park", "cemetery", "pitch", "garden"], "paint": { "fill-color": "#D9E3C6" } },
    { "id": "landcover-grass", "type": "fill", "source": "omt", "source-layer": "landcover",
      "filter": ["in", "class", "grass", "wood"], "paint": { "fill-color": "#D9E3C6", "fill-opacity": 0.7 } },
    { "id": "water", "type": "fill", "source": "omt", "source-layer": "water", "paint": { "fill-color": "#B9D5DC" } },
    { "id": "waterway", "type": "line", "source": "omt", "source-layer": "waterway",
      "paint": { "line-color": "#B9D5DC", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1, 14, 4] } },
    { "id": "building", "type": "fill", "source": "omt", "source-layer": "building", "minzoom": 14,
      "paint": { "fill-color": "#D8CFB8", "fill-opacity": 0.8 } },
    { "id": "road-casing", "type": "line", "source": "omt", "source-layer": "transportation",
      "filter": ["!in", "class", "rail", "path", "pier", "transit", "ferry"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#D8CFB8", "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 5, 1.2, 9, 3, 12, 8, 15, 18, 18, 42] } },
    { "id": "road-minor", "type": "line", "source": "omt", "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "tertiary", "residential"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#FFFFFF", "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 10, 1, 12, 3, 14, 7, 16, 14, 18, 30] } },
    { "id": "road-major", "type": "line", "source": "omt", "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk", "primary", "secondary"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#FFFFFF", "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 5, 0.8, 9, 2.5, 12, 6.5, 15, 15, 18, 36] } },
    { "id": "road-name", "type": "symbol", "source": "omt", "source-layer": "transportation_name", "minzoom": 14,
      "layout": { "symbol-placement": "line", "text-field": ["coalesce", ["get", "name:ar"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"], "text-size": 12 },
      "paint": { "text-color": "#3B4F52", "text-halo-color": "#ECE6D6", "text-halo-width": 2 } },
    { "id": "place-city", "type": "symbol", "source": "omt", "source-layer": "place",
      "filter": ["in", "class", "city", "town"],
      "layout": { "text-field": ["coalesce", ["get", "name:ar"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"], "text-size": ["interpolate", ["linear"], ["zoom"], 5, 12, 12, 20] },
      "paint": { "text-color": "#3B4F52", "text-halo-color": "#ECE6D6", "text-halo-width": 2 } },
    { "id": "place-area", "type": "symbol", "source": "omt", "source-layer": "place", "minzoom": 11,
      "filter": ["in", "class", "suburb", "neighbourhood", "village", "quarter"],
      "layout": { "text-field": ["coalesce", ["get", "name:ar"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"], "text-size": 13 },
      "paint": { "text-color": "#3B4F52", "text-halo-color": "#ECE6D6", "text-halo-width": 2 } }
  ]
}
